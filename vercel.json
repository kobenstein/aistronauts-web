{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(films|assets)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/films",
      "destination": "/portfolio",
      "permanent": true
    }
  ]
}
